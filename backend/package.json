{
  "name": "vertex-clone-backend",
  "version": "1.0.0",
  "description": "Backend API for Vertex puzzle game clone",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "migrate": "node migrations/run.js",
    "seed": "node src/utils/seedPuzzles.js",
    "setup": "npm run migrate && npm run seed",
    "test": "jest",
    "generate:geometric": "node src/utils/generateGeometric.js",
    "generate:random": "node src/utils/generateRandom.js",
    "generate:all": "node src/utils/generateAll.js"
  },
  "keywords": ["vertex", "puzzle", "game"],
  "author": "Amit Bahree",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "pg": "^8.11.3",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.1.5"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "jest": "^29.7.0"
  }
}
