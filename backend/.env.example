# Server Configuration
PORT=3000
NODE_ENV=production

# Database
DATABASE_URL=postgresql://vertex_user:vertex_password@db:5432/vertex_db

# JWT Authentication
JWT_SECRET=change-this-to-a-secure-random-string-in-production
JWT_EXPIRY=7d

# Admin Settings
ADMIN_INVITATION_REQUIRED=true
FIRST_USER_IS_ADMIN=true

# CORS
CORS_ORIGIN=*
